    "def clean_reports(data):\n",
    "    \"\"\"Clean a dataset of fictional online-harassment reports.\"\"\"\n",
    "\n",
    "    # Make a copy to protect the original data\n",
    "    cleaned = data.copy()\n",
    "\n",
    "    # Standardize category names\n",
    "    cleaned[\"category\"] = (\n",
    "        cleaned[\"category\"]\n",
    "        .fillna(\"unknown\")\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .str.lower()\n",
    "    )\n",
    "\n",
    "    # Convert severity values into numbers\n",
    "    cleaned[\"severity\"] = pd.to_numeric(\n",
    "        cleaned[\"severity\"], errors=\"coerce\"\n",
    "    )\n",
    "\n",
    "    # Replace invalid severity values with missing values\n",
    "    cleaned.loc[\n",
    "        ~cleaned[\"severity\"].between(1, 5),\n",
    "        \"severity\"\n",
    "    ] = np.nan\n",
    "\n",
    "    # Remove duplicate report IDs\n",
    "    cleaned = cleaned.drop_duplicates(\n",
    "        subset=\"report_id\",\n",
    "        keep=\"first\"\n",
    "    )\n",
    "\n",
    "    return cleaned"
   ]
  },
